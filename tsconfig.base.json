{
  "compilerOptions": {
    "target": "ES2022",
    "useDefineForClassFields": true,
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "resolveJsonModule": true,
    "allowImportingTsExtensions": false,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "jsx": "react-jsx",
    "baseUrl": ".",
    "paths": {
      "@lockedscreen/shared-types": ["packages/shared-types/src"],
      "@lockedscreen/storage": ["packages/storage/src"],
      "@lockedscreen/parser": ["packages/parser/src"],
      "@lockedscreen/exam-engine": ["packages/exam-engine/src"],
      "@lockedscreen/ui": ["packages/ui/src"]
    }
  }
}
