<UserControl x:Class="Lockedscreen.App.Views.PublishPackageView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <StackPanel Margin="24">
        <StackPanel Orientation="Horizontal">
            <TextBlock Text="Publish Package" Style="{DynamicResource SectionHeader}" />
            <Button Content="Back" Command="{Binding BackCommand}" Style="{DynamicResource GhostButton}" Margin="16,4,0,0" />
        </StackPanel>

        <TextBlock Text="Unlock PIN" />
        <PasswordBox x:Name="PinBox" PasswordChar="*" Margin="0,4,0,12" />
        <TextBlock Text="PIN Hint (optional)" />
        <TextBox Text="{Binding Draft.UnlockPinHint}" />

        <ItemsControl ItemsSource="{Binding Issues}" Margin="0,12,0,0">
            <ItemsControl.ItemTemplate>
                <DataTemplate>
                    <TextBlock Text="{Binding}" Foreground="{DynamicResource DangerBrush}" />
                </DataTemplate>
            </ItemsControl.ItemTemplate>
        </ItemsControl>

        <TextBlock Text="{Binding Status}" Foreground="{DynamicResource MutedTextBrush}" Margin="0,8,0,0" />

        <Button Content="Publish" Command="{Binding PublishCommand}" Style="{DynamicResource PrimaryButton}" Width="140" Margin="0,16,0,0" />
    </StackPanel>
</UserControl>
