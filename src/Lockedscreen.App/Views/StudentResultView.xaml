<UserControl x:Class="Lockedscreen.App.Views.StudentResultView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <StackPanel Margin="24">
        <TextBlock Text="Results" Style="{DynamicResource SectionHeader}" />
        <TextBlock Text="Score" FontWeight="SemiBold" />
        <TextBlock Text="{Binding ScoreText}" FontSize="24" />

        <StackPanel Orientation="Horizontal" Margin="0,16,0,0">
            <Button Content="Review Answers" Command="{Binding ReviewCommand}" Style="{DynamicResource GhostButton}" />
            <Button Content="Back to Login" Command="{Binding BackToLoginCommand}" Style="{DynamicResource GhostButton}" Margin="8,0,0,0" />
            <Button Content="Exit Exam" Command="{Binding ExitExamCommand}" Style="{DynamicResource PrimaryButton}" Margin="8,0,0,0" />
        </StackPanel>
    </StackPanel>
</UserControl>
