<UserControl x:Class="Lockedscreen.App.Views.StudentReviewView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <StackPanel Margin="24">
        <StackPanel Orientation="Horizontal">
            <TextBlock Text="Review Flagged" Style="{DynamicResource SectionHeader}" />
            <Button Content="Back" Command="{Binding BackCommand}" Style="{DynamicResource GhostButton}" Margin="16,4,0,0" />
        </StackPanel>

        <ItemsControl ItemsSource="{Binding FlaggedQuestions}">
            <ItemsControl.ItemTemplate>
                <DataTemplate>
                    <Button Content="{Binding PromptHtml}" Command="{Binding DataContext.GoToQuestionCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}" Style="{DynamicResource GhostButton}" Margin="0,0,0,8" />
                </DataTemplate>
            </ItemsControl.ItemTemplate>
        </ItemsControl>
    </StackPanel>
</UserControl>
