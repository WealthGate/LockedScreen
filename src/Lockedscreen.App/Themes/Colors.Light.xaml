<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Color x:Key="BackgroundColor">#EEF1F4</Color>
    <Color x:Key="SurfaceColor">#FFFFFF</Color>
    <Color x:Key="PrimaryColor">#0C684D</Color>
    <Color x:Key="PrimaryHoverColor">#0A5B44</Color>
    <Color x:Key="PrimaryPressedColor">#084B39</Color>
    <Color x:Key="AccentColor">#D38B1F</Color>
    <Color x:Key="TextColor">#1B1F23</Color>
    <Color x:Key="MutedTextColor">#4B5661</Color>
    <Color x:Key="DangerColor">#C62828</Color>
    <Color x:Key="GhostHoverColor">#E7F2ED</Color>
    <Color x:Key="GhostPressedColor">#D8EAE2</Color>
    <Color x:Key="BorderColor">#CDD6DF</Color>
    <Color x:Key="BorderHoverColor">#A9B7C5</Color>

    <SolidColorBrush x:Key="BackgroundBrush" Color="{DynamicResource BackgroundColor}" />
    <SolidColorBrush x:Key="SurfaceBrush" Color="{DynamicResource SurfaceColor}" />
    <SolidColorBrush x:Key="PrimaryBrush" Color="{DynamicResource PrimaryColor}" />
    <SolidColorBrush x:Key="PrimaryHoverBrush" Color="{DynamicResource PrimaryHoverColor}" />
    <SolidColorBrush x:Key="PrimaryPressedBrush" Color="{DynamicResource PrimaryPressedColor}" />
    <SolidColorBrush x:Key="AccentBrush" Color="{DynamicResource AccentColor}" />
    <SolidColorBrush x:Key="TextBrush" Color="{DynamicResource TextColor}" />
    <SolidColorBrush x:Key="MutedTextBrush" Color="{DynamicResource MutedTextColor}" />
    <SolidColorBrush x:Key="DangerBrush" Color="{DynamicResource DangerColor}" />
    <SolidColorBrush x:Key="GhostHoverBrush" Color="{DynamicResource GhostHoverColor}" />
    <SolidColorBrush x:Key="GhostPressedBrush" Color="{DynamicResource GhostPressedColor}" />
    <SolidColorBrush x:Key="BorderBrush" Color="{DynamicResource BorderColor}" />
    <SolidColorBrush x:Key="BorderHoverBrush" Color="{DynamicResource BorderHoverColor}" />
</ResourceDictionary>
