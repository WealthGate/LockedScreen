<Window x:Class="Lockedscreen.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="{Binding Title}" Height="900" Width="1400" WindowState="Maximized" Background="{DynamicResource BackgroundBrush}">
    <DockPanel>
        <Grid DockPanel.Dock="Top" Height="64" Background="{DynamicResource SurfaceBrush}">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="16,0">
                <Button Content="Examiner" Command="{Binding NavigateToExaminerCommand}" Style="{DynamicResource PrimaryButton}" />
                <Button Content="Student" Command="{Binding NavigateToStudentCommand}" Style="{DynamicResource GhostButton}" Margin="8,0,0,0" />
            </StackPanel>
            <TextBlock Grid.Column="1" Text="Lockedscreen" VerticalAlignment="Center" Foreground="{DynamicResource TextBrush}" FontSize="20" FontWeight="SemiBold" />
        </Grid>

        <ContentControl Content="{Binding CurrentViewModel}" />
    </DockPanel>
</Window>
